[Unit]
Description=Goldfish AI aquarium main loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raspi
WorkingDirectory=/home/raspi/aquarium-helper/goldfish_ai
ExecStart=/home/raspi/aquarium-helper/goldfish_ai/venv/bin/python run.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
